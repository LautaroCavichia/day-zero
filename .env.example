# ─────────────────────────────────────────────────────────────────────────────
# DayZero configuration — copy to .env and fill in your values.
# Switch providers by changing LLM_PROVIDER and supplying the matching key.
# ─────────────────────────────────────────────────────────────────────────────

# ── Provider selection ────────────────────────────────────────────────────────
# Allowed values: google | mistral | openai
LLM_PROVIDER=mistral

# ── Google / Gemini (default) ─────────────────────────────────────────────────
GOOGLE_API_KEY=your_ai_studio_api_key_here
GOOGLE_CLOUD_PROJECT=your-gcp-project-id   # optional, needed for Cloud Run
GOOGLE_CLOUD_REGION=us-central1
GEMINI_FLASH_MODEL=gemini-2.5-flash
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025

# ── Mistral ───────────────────────────────────────────────────────────────────
# Set LLM_PROVIDER=mistral and supply the key below.
# NOTE: Live interview is not supported with Mistral. Set ENABLE_LIVE_INTERVIEW=false.
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_API_BASE=https://api.mistral.ai/v1
MISTRAL_FLASH_MODEL=mistral-small-latest

# ── OpenAI ────────────────────────────────────────────────────────────────────
# Set LLM_PROVIDER=openai to use OpenAI for all text agents AND live audio.
# The OpenAI Realtime API (gpt-4o-realtime-preview) is the recommended
# audio-streaming alternative to Google Live API.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview
OPENAI_REALTIME_VOICE=alloy   # alloy | echo | shimmer | fable | onyx | nova

# ── Tavily web search ─────────────────────────────────────────────────────────
# Required for market validation when LLM_PROVIDER != google.
# (Google uses its own native Search grounding; all other providers use Tavily.)
# Get a free key at https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here
TAVILY_SEARCH_DEPTH=basic        # basic (faster) | advanced (more results)
TAVILY_MAX_RESULTS=5

# ── Feature flags ─────────────────────────────────────────────────────────────
ENABLE_DECK_ANALYSIS=true
ENABLE_MARKET_VALIDATION=true
ENABLE_LIVE_INTERVIEW=false       # set to false when using Mistral provider
